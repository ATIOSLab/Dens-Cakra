{
  "name": "be",
  "version": "0.0.1",
  "description": "DEN CAKRA backend foundation with NestJS, Prisma, and Better Auth",
  "author": "",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"prisma.config.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:reset:postgis": "scripts\\reset-db-with-postgis.cmd",
    "prisma:studio": "prisma studio",
    "seed:admin": "npm run build && node dist/src/scripts/seed-admin.js",
    "seed:executive": "npm run build && node dist/src/scripts/seed-executive.js",
    "seed:superadmin": "npm run build && node dist/src/scripts/seed-superadmin.js",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "seed:roles": "npm run build:scripts && node dist/src/scripts/seed-role-accounts.js",
    "seed:rbac-foundation": "npm run build:scripts && node dist/src/scripts/seed-rbac-foundation.js",
    "seed:accounts": "npm run build:scripts && node dist/src/scripts/seed-role-accounts.js",
    "seed:master": "npm run build && node dist/src/scripts/seed-master.js",
    "seed:wilayah": "npm run build && node dist/src/scripts/seed-wilayah.js",
    "seed:wilayah-boundaries": "npm run build && node dist/src/scripts/seed-wilayah-boundaries.js",
    "seed:str-hierarchy": "npm run build:scripts && node dist/src/scripts/seed-str-hierarchy.js",
    "seed:baket": "npm run build:scripts && node dist/src/scripts/seed-baket.js",
    "backfill:baket-references": "npm run build:scripts && node dist/src/scripts/backfill-baket-references.js",
    "seed:demo:jakarta": "npm run build:scripts && node dist/src/scripts/seed-jakarta-demo.js",
    "seed:jaring:jakarta-selatan": "npm run build:scripts && node dist/src/scripts/seed-jakarta-jaring.js",
    "seed:jaring:jakarta-selatan:check": "npm run build:scripts && node dist/src/scripts/seed-jakarta-jaring.js --dry-run",
    "seed:geo:jakarta-districts": "npm run build && node dist/src/scripts/seed-jakarta-district-boundaries.js",
    "seed:all": "npm run build && node dist/src/scripts/seed-all.js",
    "repair:baket-intake": "npm run build && node dist/src/scripts/repair-baket-intake-duplicates.js",
    "repair:baket-areas": "npm run build && node dist/src/scripts/repair-baket-area-resolution.js"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.23",
    "@hapi/boom": "^10.0.1",
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/nodemailer": "^8.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.13",
    "better-auth": "^1.6.23",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.2.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "overrides": {
    "js-yaml": "^5.2.3"
  }
}
