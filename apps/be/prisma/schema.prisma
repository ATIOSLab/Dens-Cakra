/**
 * =========================================================
 * AUTH LAYER AND DOMAIN USER PROFILE
 * =======================================================
 */

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  role            String    @default("field_officer")
  username        String?   @unique
  displayUsername String?
  banned          Boolean   @default(false)
  banReason       String?
  banExpires      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  profile  UserProfile? @relation("AuthUserProfile")

  @@map("user")
}

model Session {
  id             String    @id
  userId         String
  token          String    @unique
  expiresAt      DateTime
  ipAddress      String?
  locationLabel  String?   @db.VarChar(255)
  userAgent      String?
  impersonatedBy String?
  lastSeenAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model UserProfile {
  id                     String                  @id @default(uuid()) @db.Uuid
  authUserId             String                  @unique
  username               String?                 @unique @db.VarChar(100)
  fullName               String?                 @db.VarChar(180)
  phone                  String?                 @db.VarChar(30)
  nationalIdNumber       String?                 @db.Char(16)
  birthPlace             String?                 @db.VarChar(120)
  birthDate              DateTime?               @db.Date
  gender                 PersonnelGender?
  religion               String?                 @db.VarChar(80)
  maritalStatus          PersonnelMaritalStatus?
  bloodType              String?                 @db.VarChar(5)
  personnelNumber        String?                 @db.VarChar(80)
  rankGrade              String?                 @db.VarChar(120)
  personnelStatus        PersonnelStatus?
  joinedAt               DateTime?               @db.Date
  lastEducation          String?                 @db.VarChar(120)
  educationInstitution   String?                 @db.VarChar(180)
  educationMajor         String?                 @db.VarChar(150)
  graduationYear         Int?
  positionHistory        Json?
  assignmentHistory      Json?
  competencies           Json?
  status                 UserProfileStatus       @default(PENDING)
  isActive               Boolean                 @default(true)
  operationalLockedAt    DateTime?
  operationalLockReason  String?                 @db.Text
  operationalLockedUntil DateTime?
  lastLoginAt            DateTime?
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  authUser User @relation("AuthUserProfile", fields: [authUserId], references: [id], onDelete: Restrict)

  operationalAssignments UserOperationalAssignment[]
  notifications          Notification[]
  auditLogs              AuditLog[]                  @relation("AuditActor")
  receivedDistributions  ProductDistribution[]       @relation("DistributionTargetUser")
  whatsappDeviceLogs     WhatsAppDeviceActivityLog[] @relation("WhatsAppDeviceActivityUser")

  @@index([isActive, deletedAt])
  @@index([status, deletedAt])
  @@index([nationalIdNumber])
  @@index([personnelStatus])
  @@map("user_profile")
}

/**
 * =========================================================
 * AUTHORIZATION AND USER SCOPE
 * =======================================================
 */

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        RoleCode @unique
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  operationalAssignments UserOperationalAssignment[]
  rolePermissions        RolePermission[]
  positions              Position[]
}

model UserOperationalAssignment {
  id            String           @id @default(uuid()) @db.Uuid
  userProfileId String           @db.Uuid
  roleId        String           @db.Uuid
  positionId    String?          @db.Uuid
  branch        CommandRouteType
  isPrimary     Boolean          @default(true)
  isActive      Boolean          @default(true)
  validFrom     DateTime         @default(now())
  validUntil    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Restrict)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  position    Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)

  areaScopes                  UserAreaScope[]
  filesCreated                FileAsset[]
  supervisionAssignments      SupervisionAssignment[]      @relation("SupervisionDirectorate")
  directivesOwned             Directive[]                 @relation("DirectiveOwnerAssignment")
  directiveRecipientsTargeted DirectiveRecipient[]        @relation("DirectiveRecipientAssignment")
  uukStrsOwned                UukStr[]                    @relation("UukOwnerAssignment")
  tasksOwned                  Task[]                      @relation("TaskOwnerAssignment")
  analysisCasesOwned          AnalysisCase[]              @relation("AnalysisCaseOwnerAssignment")
  intelligenceProductsOwned   IntelligenceProduct[]       @relation("ProductOwnerAssignment")
  approvalTargets             ProductApprovalStep[]       @relation("ApprovalTargetAssignment")
  distributionTargets         ProductDistribution[]       @relation("DistributionTargetAssignment")
  assignedAlerts              Alert[]                     @relation("AlertAssignedAssignment")
  directivesCreated           Directive[]                 @relation("DirectiveCreatedBy")
  directiveVersionsCreated    DirectiveVersion[]          @relation("DirectiveVersionCreatedBy")
  uukStrsCreated              UukStr[]                    @relation("UukCreatedBy")
  uukStrVersionsCreated       UukStrVersion[]             @relation("UukVersionCreatedBy")
  tasksCreated                Task[]                      @relation("TaskCreatedBy")
  taskAssignmentsGiven        TaskAssignment[]            @relation("TaskAssignedBy")
  taskAssignmentsReceived     TaskAssignment[]            @relation("TaskAssignedTo")
  taskProgressCreated         TaskProgressLog[]
  jaringCreated               Jaring[]                    @relation("JaringCreatedBy")
  jaringReviewed              Jaring[]                    @relation("JaringReviewedBy")
  jaringCaretakerAssignments  JaringCaretakerAssignment[]
  jaringCoachingReports       JaringCoachingReport[]      @relation("JaringCoachingReportFieldOfficer")
  routedWhatsAppMessages      WhatsAppMessage[]           @relation("WhatsAppRoutedTo")
  whatsappRoutingLogs         WhatsAppRoutingLog[]
  whatsappReportSessions      WhatsAppReportSession[]     @relation("WhatsAppReportFieldOfficer")
  whatsappDeviceLogs          WhatsAppDeviceActivityLog[] @relation("WhatsAppDeviceActivityAssignment")
  baketsCreated               Baket[]                     @relation("BaketCreatedBy")
  baketVersionsCreated        BaketVersion[]              @relation("BaketVersionCreatedBy")
  baketRevisionRequests       BaketRevisionRequest[]
  verifications               BaketVerification[]
  baketCoverageChecks         BaketCoverageCheck[]
  analysisCasesCreated        AnalysisCase[]              @relation("AnalysisCaseCreatedBy")
  analysisVersionsCreated     AnalysisVersion[]           @relation("AnalysisVersionCreatedBy")
  analysisVersionsValidated   AnalysisVersion[]           @relation("AnalysisVersionValidatedBy")
  productsCreated             IntelligenceProduct[]       @relation("ProductCreatedBy")
  productVersionsCreated      ProductVersion[]            @relation("ProductVersionCreatedBy")
  approvalDecisions           ProductApprovalStep[]       @relation("ApprovalDecidedBy")
  productDistributionsSent    ProductDistribution[]       @relation("DistributionSentBy")
  emergencyReportsCreated     EmergencyIncident[]         @relation("EmergencyReportedBy")
  auditLogs                   AuditLog[]                  @relation("AuditAssignment")
  locationPings               PersonnelLocationPing[]

  @@index([userProfileId, isActive])
  @@index([roleId, branch, isActive])
}

model RoleAreaPolicy {
  id                  String              @id @default(uuid()) @db.Uuid
  roleCode            RoleCode
  branch              CommandRouteType?
  administrativeLevel AdministrativeLevel
  scopeMode           AreaScopeMode       @default(EXPLICIT)
  minimumAreas        Int                 @default(1)
  maximumAreas        Int?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([roleCode, branch, administrativeLevel])
}

model UserAreaScope {
  id                      String    @id @default(uuid()) @db.Uuid
  operationalAssignmentId String    @db.Uuid
  areaId                  String    @db.Uuid
  isPrimary               Boolean   @default(false)
  validFrom               DateTime  @default(now())
  validUntil              DateTime?
  createdAt               DateTime  @default(now())

  assignment UserOperationalAssignment @relation(fields: [operationalAssignmentId], references: [id], onDelete: Cascade)
  area       AdministrativeArea        @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@unique([operationalAssignmentId, areaId, validFrom])
  @@index([areaId, validUntil])
  @@index([operationalAssignmentId, validUntil])
}

/**
 * =========================================================
 * ADMINISTRATIVE AREA AND COVERAGE
 * =======================================================
 */

model AdministrativeArea {
  id                String              @id @default(uuid()) @db.Uuid
  code              String              @db.VarChar(50)
  officialCode      String?             @unique @db.VarChar(30)
  name              String              @db.VarChar(180)
  level             AdministrativeLevel
  parentId          String?             @db.Uuid
  centroidLatitude  Decimal?            @db.Decimal(10, 7)
  centroidLongitude Decimal?            @db.Decimal(10, 7)
  isActive          Boolean             @default(true)
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  parent   AdministrativeArea?  @relation("AdministrativeAreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children AdministrativeArea[] @relation("AdministrativeAreaHierarchy")

  ancestorLinks   AdministrativeAreaClosure[] @relation("AreaClosureAncestor")
  descendantLinks AdministrativeAreaClosure[] @relation("AreaClosureDescendant")

  boundaries               AdministrativeAreaBoundary[]
  assignmentScopes         UserAreaScope[]
  directiveTargets         DirectiveTargetArea[]
  taskTargets              TaskTargetArea[]
  jaringCoverages          JaringAreaCoverage[]
  resolvedWhatsAppMessages WhatsAppMessage[]            @relation("WhatsAppResolvedArea")
  baketVersions            BaketVersion[]
  baketCoverageChecks      BaketCoverageCheck[]
  emergencyIncidents       EmergencyIncident[]
  alerts                   Alert[]
  personnelLocationPings   PersonnelLocationPing[]
  whatsappDeviceLogs       WhatsAppDeviceActivityLog[]  @relation("WhatsAppDeviceActivityArea")
  supervisionAssignments   SupervisionAssignment[]

  @@unique([parentId, level, code])
  @@index([parentId, level])
  @@index([name])
  @@index([level, isActive])
}

model AdministrativeAreaClosure {
  ancestorId   String @db.Uuid
  descendantId String @db.Uuid
  depth        Int

  ancestor   AdministrativeArea @relation("AreaClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant AdministrativeArea @relation("AreaClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId, depth])
  @@index([ancestorId, depth])
}

model AdministrativeAreaDataSource {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(200)
  sourceType     String    @db.VarChar(80)
  referenceUrl   String?   @db.VarChar(500)
  versionLabel   String?   @db.VarChar(100)
  effectiveDate  DateTime?
  importedAt     DateTime  @default(now())
  checksumSha256 String?   @db.VarChar(64)
  notes          String?   @db.Text

  boundaries AdministrativeAreaBoundary[]

  @@index([name, versionLabel])
}

model AdministrativeAreaBoundary {
  id                            String                                     @id @default(uuid()) @db.Uuid
  areaId                        String                                     @db.Uuid
  dataSourceId                  String?                                    @db.Uuid
  versionNumber                 Int
  boundary                      Unsupported("geometry(MultiPolygon,4326)")
  centroid                      Unsupported("geometry(Point,4326)")?
  minLatitude                   Decimal?                                   @db.Decimal(10, 7)
  minLongitude                  Decimal?                                   @db.Decimal(10, 7)
  maxLatitude                   Decimal?                                   @db.Decimal(10, 7)
  maxLongitude                  Decimal?                                   @db.Decimal(10, 7)
  qualityStatus                 BoundaryQualityStatus                      @default(VERIFIED)
  simplificationToleranceMeters Decimal?                                   @db.Decimal(12, 2)
  geometryHash                  String?                                    @db.VarChar(64)
  effectiveFrom                 DateTime
  effectiveUntil                DateTime?
  isActive                      Boolean                                    @default(true)
  createdAt                     DateTime                                   @default(now())
  updatedAt                     DateTime                                   @updatedAt

  area       AdministrativeArea            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  dataSource AdministrativeAreaDataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)

  @@unique([areaId, versionNumber])
  @@index([areaId, isActive, effectiveFrom])
  @@index([dataSourceId])
}

/**
 * =========================================================
 * FILE STORAGE
 * =======================================================
 */

model FileAsset {
  id                    String              @id @default(uuid()) @db.Uuid
  storageKey            String              @unique @db.VarChar(500)
  originalName          String?             @db.VarChar(255)
  mimeType              String              @db.VarChar(120)
  fileType              FileType
  sizeBytes             BigInt
  checksumSha256        String              @db.VarChar(64)
  lifecycleStatus       FileLifecycleStatus @default(PENDING_UPLOAD)
  scanResult            Json?
  scannedAt             DateTime?
  quarantineReason      String?             @db.Text
  retentionUntil        DateTime?
  createdByAssignmentId String?             @db.Uuid
  createdAt             DateTime            @default(now())
  deletedAt             DateTime?

  createdByAssignment UserOperationalAssignment? @relation(fields: [createdByAssignmentId], references: [id], onDelete: SetNull)

  whatsAppMedia        WhatsAppMessageMedia[]
  whatsAppReportMedia  WhatsAppReportMedia[]     @relation("WhatsAppReportMediaFile")
  whatsappPendingMedia WhatsAppReportSession[]   @relation("WhatsAppReportPendingFile")
  whatsappAmendments   WhatsAppReportAmendment[] @relation("WhatsAppReportAmendmentFile")
  taskAttachments      TaskAttachment[]
  baketAttachments     BaketVersionAttachment[]
  productAttachments   ProductAttachment[]
  emergencyAttachments EmergencyAttachment[]
  coachingReportAttachments CoachingReportAttachment[]
  uploadReservation    FileUploadReservation?
  jaringProfilePhotos  Jaring[]                  @relation("JaringProfilePhoto")

  @@index([createdAt])
}

/**
 * =========================================================
 * DIRECTIVE AND UUK/STR
 * =======================================================
 */

model Directive {
  id                    String          @id @default(uuid()) @db.Uuid
  commandNumber         String          @unique @db.VarChar(120)
  ownerAssignmentId     String          @db.Uuid
  createdByAssignmentId String          @db.Uuid
  status                DirectiveStatus @default(DRAFT)
  currentVersionNumber  Int             @default(1)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  ownerAssignment     UserOperationalAssignment @relation("DirectiveOwnerAssignment", fields: [ownerAssignmentId], references: [id], onDelete: Restrict)
  createdByAssignment UserOperationalAssignment @relation("DirectiveCreatedBy", fields: [createdByAssignmentId], references: [id], onDelete: Restrict)

  versions DirectiveVersion[]

  @@index([ownerAssignmentId, status])
}

model DirectiveVersion {
  id                    String         @id @default(uuid()) @db.Uuid
  directiveId           String         @db.Uuid
  versionNumber         Int
  classification        Classification
  urgency               PriorityLevel  @default(NORMAL)
  commandSource         String         @db.VarChar(250)
  commandIssuer         String         @db.VarChar(250)
  commandDate           DateTime
  dueDate               DateTime?
  strategicIssue        String?        @db.Text
  commandDescription    String         @db.Text
  createdByAssignmentId String         @db.Uuid
  changeReason          String?        @db.Text
  createdAt             DateTime       @default(now())

  directive           Directive                 @relation(fields: [directiveId], references: [id], onDelete: Cascade)
  createdByAssignment UserOperationalAssignment @relation("DirectiveVersionCreatedBy", fields: [createdByAssignmentId], references: [id], onDelete: Restrict)

  targetAreas DirectiveTargetArea[]
  recipients  DirectiveRecipient[]
  uukStrs     UukStr[]
  tasks       Task[]

  @@unique([directiveId, versionNumber])
  @@index([classification, commandDate])
  @@index([commandDate])
}

model DirectiveTargetArea {
  directiveVersionId String  @db.Uuid
  areaId             String  @db.Uuid
  isPrimary          Boolean @default(false)

  directiveVersion DirectiveVersion   @relation(fields: [directiveVersionId], references: [id], onDelete: Cascade)
  area             AdministrativeArea @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@id([directiveVersionId, areaId])
  @@index([areaId])
}

