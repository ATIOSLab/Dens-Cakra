model AnalysisEntity {
  id                String          @id @default(uuid()) @db.Uuid
  analysisVersionId String          @db.Uuid
  entityType        IntelEntityType
  name              String          @db.VarChar(250)
  normalizedName    String?         @db.VarChar(250)
