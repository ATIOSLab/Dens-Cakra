/**
 * =========================================================
 * API RUNTIME, DURABLE JOBS, AND IMMUTABLE EVENTS
 * =======================================================
 */

model ApiIdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  scopeKey       String            @db.VarChar(180)
  operationId    String            @db.VarChar(80)
  idempotencyKey String            @db.VarChar(180)
  requestHash    String            @db.VarChar(64)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  resourceType   String?           @db.VarChar(120)
  resourceId     String?           @db.VarChar(120)
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([scopeKey, operationId, idempotencyKey])
  @@index([expiresAt])
}

model AsyncJob {
  id            String         @id @default(uuid()) @db.Uuid
  type          String         @db.VarChar(120)
  status        AsyncJobStatus @default(QUEUED)
  payload       Json
  result        Json?
  progress      Int            @default(0)
  attempts      Int            @default(0)
  maxAttempts   Int            @default(5)
  availableAt   DateTime       @default(now())
  lockedAt      DateTime?
  lockedBy      String?        @db.VarChar(120)
  lastError     String?        @db.Text
  requestedById String?        @db.Uuid
  correlationId String?        @db.VarChar(120)
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, availableAt])
  @@index([type, createdAt])
  @@index([correlationId])
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  topic         String            @db.VarChar(120)
  aggregateType String            @db.VarChar(120)
  aggregateId   String            @db.VarChar(120)
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  lockedAt      DateTime?
  lockedBy      String?           @db.VarChar(120)
  lastError     String?           @db.Text
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model FileUploadReservation {
  id                    String    @id @default(uuid()) @db.Uuid
  storageKey            String    @unique @db.VarChar(500)
  originalName          String    @db.VarChar(255)
  mimeType              String    @db.VarChar(120)
  fileType              FileType
  sizeBytes             BigInt
  checksumSha256        String    @db.VarChar(64)
  context               String    @db.VarChar(80)
  uploadTokenHash       String    @unique @db.VarChar(64)
  createdByAssignmentId String    @db.Uuid
  fileAssetId           String?   @unique @db.Uuid
  expiresAt             DateTime
  completedAt           DateTime?
  createdAt             DateTime  @default(now())

  fileAsset FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@index([createdByAssignmentId, createdAt])
  @@index([expiresAt])
}

model ProductApprovalEvent {
  id                String            @id @default(uuid()) @db.Uuid
  workflowId        String            @db.Uuid
  stepId            String?           @db.Uuid
  eventType         ApprovalEventType
  actorAssignmentId String?           @db.Uuid
  note              String?           @db.Text
  metadata          Json?
  createdAt         DateTime          @default(now())

  workflow ProductApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  step     ProductApprovalStep?    @relation(fields: [stepId], references: [id], onDelete: Restrict)

  @@index([workflowId, createdAt])
  @@index([stepId, createdAt])
  @@index([actorAssignmentId, createdAt])
}
