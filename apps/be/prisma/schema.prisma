model WhatsAppReportSession {
  id                       String                      @id @default(uuid()) @db.Uuid
  integrationChannelId     String                      @db.Uuid
  senderPhone              String                      @db.VarChar(30)
  remoteJid                String                      @db.VarChar(160)
  activeSenderKey          String?                     @unique @db.VarChar(30)
  jaringId                 String                      @db.Uuid
  fieldOfficerAssignmentId String                      @db.Uuid
  currentState             WhatsAppReportSessionState
  status                   WhatsAppReportSessionStatus @default(ACTIVE)
  content                  String?                     @db.Text
  latitude                 Decimal?                    @db.Decimal(10, 7)
  longitude                Decimal?                    @db.Decimal(10, 7)
  locationAccuracyMeters   Decimal?                    @db.Decimal(10, 2)
  locationCapturedAt       DateTime?
  locationMessageId        String?                     @db.VarChar(255)
  locationType             String?                     @db.VarChar(40)
  timezone                 String                      @default("Asia/Jakarta") @db.VarChar(60)
  returnToReview           Boolean                     @default(false)
  resumeState              WhatsAppReportSessionState?
  pendingAmendmentText     String?                     @db.Text
  pendingFileId            String?                     @db.Uuid
  submittedMessageId       String?                     @unique @db.Uuid
  referenceNumber          String?                     @unique @db.VarChar(24)
  startedAt                DateTime                    @default(now())
  lastActivityAt           DateTime                    @default(now())
  expiresAt                DateTime
  submittedAt              DateTime?
  closedAt                 DateTime?
  readAt                   DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  integrationChannel     IntegrationChannel          @relation(fields: [integrationChannelId], references: [id], onDelete: Restrict)
  jaring                 Jaring                      @relation(fields: [jaringId], references: [id], onDelete: Restrict)
  fieldOfficerAssignment UserOperationalAssignment   @relation("WhatsAppReportFieldOfficer", fields: [fieldOfficerAssignmentId], references: [id], onDelete: Restrict)
  submittedMessage       WhatsAppMessage?            @relation(fields: [submittedMessageId], references: [id], onDelete: SetNull)
  pendingFile            FileAsset?                  @relation("WhatsAppReportPendingFile", fields: [pendingFileId], references: [id], onDelete: SetNull)
  contentParts           WhatsAppReportContentPart[]
  media                  WhatsAppReportMedia[]
  history                WhatsAppReportHistory[]
  amendments             WhatsAppReportAmendment[]

