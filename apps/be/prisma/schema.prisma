  verification BaketVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@unique([verificationId, code])
}

model BaketVerificationCrossReference {
  id             String  @id @default(uuid()) @db.Uuid
  verificationId String  @db.Uuid
  relatedBaketId String? @db.Uuid
