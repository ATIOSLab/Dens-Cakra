model IntelligenceProduct {
  id                    String         @id @default(uuid()) @db.Uuid
  productTypeId         String         @db.Uuid
  ownerUnitId           String         @db.Uuid
  createdByAssignmentId String         @db.Uuid
  productNumber         String         @unique @db.VarChar(150)
