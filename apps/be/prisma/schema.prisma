  reason                   String?                      @db.Text
  errorMessage             String?                      @db.Text
  metadata                 Json?
  occurredAt               DateTime                     @default(now())
  createdAt                DateTime                     @default(now())

  channel               IntegrationChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderNumber          WhatsAppSenderNumber?      @relation(fields: [senderNumberId], references: [id], onDelete: SetNull)
  scopeArea             AdministrativeArea?        @relation("WhatsAppDeviceActivityArea", fields: [scopeAreaId], references: [id], onDelete: SetNull)
  userProfile           UserProfile?               @relation("WhatsAppDeviceActivityUser", fields: [userProfileId], references: [id], onDelete: SetNull)
  operationalAssignment UserOperationalAssignment? @relation("WhatsAppDeviceActivityAssignment", fields: [operationalAssignmentId], references: [id], onDelete: SetNull)

  @@index([channelId, occurredAt])
  @@index([phoneNumber, occurredAt])
  @@index([connectionStatus, occurredAt])
  @@index([eventType, occurredAt])
  @@index([scopeAreaId, occurredAt])
  @@index([userProfileId, occurredAt])
}

model WhatsAppNotificationRecipient {
  id                   String   @id @default(uuid()) @db.Uuid
  email                String   @unique @db.VarChar(250)
  label                String?  @db.VarChar(160)
  isActive             Boolean  @default(true)
  notifyOnConnected    Boolean  @default(true)
  notifyOnDisconnected Boolean  @default(true)
  notifyOnError        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive])
}

model IntegrationWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  channelId       String    @db.Uuid
  externalEventId String?   @db.VarChar(255)
  senderPhone     String?   @db.VarChar(30)
  eventType       String    @db.VarChar(120)
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  success         Boolean?
  errorMessage    String?   @db.Text

  channel IntegrationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalEventId])
  @@index([channelId, receivedAt])
  @@index([success, processedAt])
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(150)
  value       Json
  description String?  @db.Text
  isSecret    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * =========================================================
 * API RUNTIME, DURABLE JOBS, AND IMMUTABLE EVENTS
 * =======================================================
 */

model ApiIdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  scopeKey       String            @db.VarChar(180)
  operationId    String            @db.VarChar(80)
  idempotencyKey String            @db.VarChar(180)
  requestHash    String            @db.VarChar(64)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  resourceType   String?           @db.VarChar(120)
  resourceId     String?           @db.VarChar(120)
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([scopeKey, operationId, idempotencyKey])
  @@index([expiresAt])
}

model AsyncJob {
  id            String         @id @default(uuid()) @db.Uuid
  type          String         @db.VarChar(120)
  status        AsyncJobStatus @default(QUEUED)
  payload       Json
  result        Json?
  progress      Int            @default(0)
  attempts      Int            @default(0)
  maxAttempts   Int            @default(5)
  availableAt   DateTime       @default(now())
  lockedAt      DateTime?
  lockedBy      String?        @db.VarChar(120)
  lastError     String?        @db.Text
  requestedById String?        @db.Uuid
  correlationId String?        @db.VarChar(120)
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, availableAt])
  @@index([type, createdAt])
  @@index([correlationId])
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  topic         String            @db.VarChar(120)
  aggregateType String            @db.VarChar(120)
  aggregateId   String            @db.VarChar(120)
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  lockedAt      DateTime?
  lockedBy      String?           @db.VarChar(120)
  lastError     String?           @db.Text
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model FileUploadReservation {
  id                    String    @id @default(uuid()) @db.Uuid
  storageKey            String    @unique @db.VarChar(500)
  originalName          String    @db.VarChar(255)
  mimeType              String    @db.VarChar(120)
  fileType              FileType
  sizeBytes             BigInt
  checksumSha256        String    @db.VarChar(64)
  context               String    @db.VarChar(80)
  uploadTokenHash       String    @unique @db.VarChar(64)
  createdByAssignmentId String    @db.Uuid
  fileAssetId           String?   @unique @db.Uuid
  expiresAt             DateTime
  completedAt           DateTime?
  createdAt             DateTime  @default(now())

  fileAsset FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@index([createdByAssignmentId, createdAt])
  @@index([expiresAt])
}

model ProductApprovalEvent {
  id                String            @id @default(uuid()) @db.Uuid
  workflowId        String            @db.Uuid
  stepId            String?           @db.Uuid
  eventType         ApprovalEventType
  actorAssignmentId String?           @db.Uuid
  note              String?           @db.Text
  metadata          Json?
  createdAt         DateTime          @default(now())

  workflow ProductApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  step     ProductApprovalStep?    @relation(fields: [stepId], references: [id], onDelete: Restrict)

  @@index([workflowId, createdAt])
  @@index([stepId, createdAt])
  @@index([actorAssignmentId, createdAt])
}

// =========================================================
// DYNAMIC PERMISSION SYSTEM
// =======================================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// =========================================================
// POSITION (JABATAN) - terpisah dari Role
// =======================================================

model Position {
  id                 String      @id @default(uuid()) @db.Uuid
  code               String      @unique @db.VarChar(80)
  name               String      @db.VarChar(120)
  description        String?     @db.Text
  roleId             String      @db.Uuid
  organizationLevel  String?     @db.VarChar(60)
  isSystem           Boolean     @default(false)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignments UserOperationalAssignment[]

  @@index([roleId, isActive])
}

// =========================================================
// SUPERVISION ASSIGNMENT (Direktorat -> wilayah)
// =======================================================

enum SupervisionType {
  BINDA_SUPERVISION
  DIRECT_SUPERVISION
}

model SupervisionAssignment {
  id             String          @id @default(uuid()) @db.Uuid
  directorateAssignmentId String @db.Uuid
  targetRegionId String          @db.Uuid
  supervisionType SupervisionType @default(BINDA_SUPERVISION)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  directorateAssignment UserOperationalAssignment @relation("SupervisionDirectorate", fields: [directorateAssignmentId], references: [id], onDelete: Restrict)
  targetRegion          AdministrativeArea         @relation(fields: [targetRegionId], references: [id], onDelete: Restrict)

  @@unique([directorateAssignmentId, targetRegionId])
  @@index([targetRegionId, supervisionType])
}

// =========================================================
// ORGANIZATION UNIT
// =======================================================

model OrganizationUnit {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(160)
  type      String   @db.VarChar(60)
  level     String?  @db.VarChar(60)
  parentId  String?  @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   OrganizationUnit?  @relation("OrganizationUnitParent", fields: [parentId], references: [id], onDelete: SetNull)
  children OrganizationUnit[] @relation("OrganizationUnitParent")

  @@index([parentId, type])
  @@index([type, isActive])
}
