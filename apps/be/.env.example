NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/denscakra_db?schema=public"

BETTER_AUTH_SECRET="replace-with-a-strong-secret-at-least-32-characters"
# Saat frontend Next.js menjadi reverse proxy Better Auth, gunakan origin frontend publik.
BETTER_AUTH_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

AUTH_DISABLE_SIGN_UP=false

EMAIL_PROVIDER="smtp"
EMAIL_FROM="ExamCPNS <noreply@example.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-app-password"

BOOTSTRAP_ADMIN_NAME="Admin System DEN CAKRA"
BOOTSTRAP_ADMIN_EMAIL="admin@denscakra.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"

# WhatsApp Center / Baileys
WHATSAPP_ENABLED=true
WHATSAPP_AUTH_DIR="wa_auth"
# qr = scan QR dari WhatsApp > Linked Devices, code = pairing code nomor bot.
WHATSAPP_PAIRING_METHOD="qr"
WHATSAPP_BOT_PHONE_NUMBER="6285111323860"
# Nomor Field Coordinator/admin yang boleh memakai command admin WA, pisahkan koma.
ADMIN_WHATSAPP_IDS=""
