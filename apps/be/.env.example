NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/denscakra_db?schema=public"

BETTER_AUTH_SECRET="replace-with-a-strong-secret-at-least-32-characters"
# Saat frontend Next.js menjadi reverse proxy Better Auth, gunakan origin frontend publik.
BETTER_AUTH_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

AUTH_DISABLE_SIGN_UP=true
API_DOCS_ENABLED=true

WORKER_ENABLED=true
WORKER_ID="dens-cakra-local"
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_TIMEOUT_MS=60000

REDIS_URL="redis://127.0.0.1:6379"
REDIS_KEY_PREFIX="denscakra"
WHATSAPP_REPORT_SESSION_TTL_SECONDS=1800
WHATSAPP_REPORT_LOCK_TTL_MS=180000
WHATSAPP_REPORT_LOCK_WAIT_MS=120000
WHATSAPP_MESSAGE_DEDUPE_TTL_SECONDS=86400

LOCAL_STORAGE_ROOT="./storage"
WHATSAPP_AUTH_ROOT="./wa_auth"
STORAGE_SIGNING_SECRET="replace-with-a-different-strong-secret"
MAX_FILE_SIZE_BYTES=26214400
APPLICATION_ENCRYPTION_KEY="replace-with-a-32-byte-application-key"

EMAIL_PROVIDER="smtp"
EMAIL_FROM="ExamCPNS <noreply@example.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-app-password"

BOOTSTRAP_ADMIN_NAME="Admin System DEN CAKRA"
BOOTSTRAP_ADMIN_EMAIL="admin@denscakra.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"

BOOTSTRAP_SUPERADMIN_NAME="Super Admin DENS CAKRA"
BOOTSTRAP_SUPERADMIN_EMAIL="superadmin@denscakra.local"
BOOTSTRAP_SUPERADMIN_PASSWORD="SuperAdmin123!"
# OpenAI-compatible AI router for Directive Strategic recommendations
AI_ROUTER_BASE_URL=https://your-ai-router.example/v1
AI_ROUTER_API_KEY=replace-with-your-api-key
AI_ROUTER_MODEL=replace-with-your-combo-name

# Dokploy startup controls
RUN_MIGRATIONS_ON_STARTUP=true
RUN_SEED_ON_STARTUP=false
RUN_JAKARTA_SEED_ON_STARTUP=false
WAIT_FOR_DB_TIMEOUT_MS=60000
WAIT_FOR_DB_INTERVAL_MS=2000
